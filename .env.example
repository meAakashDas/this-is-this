# ==============================================================================
# Aakash Das Personal Website — Firebase Client Environment Configuration
# ==============================================================================
# These variables configure the Firebase Web Client SDK for the Admin CMS.
# They are public-facing browser client identifiers (safe to expose to client bundle).
# Authorization is strictly enforced by Firebase Security Rules and Google OAuth,
# NOT by keeping these keys secret.
#
# NEVER put private service account keys or server secrets in PUBLIC_ variables.
#
# To use:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. Populate values from Firebase Console > Project Settings > General > Web Apps.
# ==============================================================================

# Firebase Web App API Key
PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here

# Firebase Auth Domain (e.g., your-project-id.firebaseapp.com)
PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com

# Firebase Project ID
PUBLIC_FIREBASE_PROJECT_ID=your_project_id

# Firebase Storage Bucket (e.g., your-project-id.appspot.com or your-project-id.firebasestorage.app)
PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app

# Firebase Cloud Messaging Sender ID
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

# Firebase Web App ID (e.g., 1:1234567890:web:abcdef123456)
PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
