---
import { getPublicSiteConfig } from '../lib/cms/contentLoader';
import Icon from './Icon.astro';

const siteConfig = getPublicSiteConfig();

const getDisplayName = (platform: string) => {
  if (platform.includes('X') || platform.includes('Twitter')) return 'X';
  return platform;
};

// Direct contact links
const phoneTel = siteConfig.phone
  ? `tel:${siteConfig.phone.replace(/\s+/g, '')}`
  : 'tel:+977-XXXXXXXXXX';

const whatsappHref = siteConfig.whatsappNumber
  ? siteConfig.whatsappNumber.includes('X')
    ? `https://wa.me/${siteConfig.whatsappNumber}`
    : `https://wa.me/${siteConfig.whatsappNumber.replace(/\D/g, '')}`
  : 'https://wa.me/977XXXXXXXXXX';
---

<footer class="site-footer w-full mt-auto border-t border-border bg-background transition-colors py-8 sm:py-10">
  <div class="page-container footer-inner max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row items-center lg:items-start justify-between gap-6">
    <!-- Left: Navigation and Social Links -->
    <div class="footer-left flex flex-col items-center lg:items-start gap-2.5 sm:gap-3">
      <!-- Footer Navigation -->
      <nav class="footer-nav flex items-center justify-center lg:justify-start gap-1 flex-wrap" aria-label="Footer Navigation">
        {siteConfig.navItems.map((item) => (
          <a
            href={item.href}
            class="footer-nav-link text-xs sm:text-[13px] font-medium text-muted-foreground hover:text-foreground px-2.5 py-1.5 rounded-md hover:bg-secondary transition-colors no-underline whitespace-nowrap"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Social Links -->
      <div class="footer-social-links flex items-center justify-center lg:justify-start gap-1 flex-wrap" aria-label="Footer Social Links">
        {siteConfig.socialLinks.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social-link inline-flex items-center gap-1 text-xs sm:text-[13px] font-medium text-muted-foreground hover:text-foreground px-2.5 py-1.5 rounded-md hover:bg-secondary transition-colors no-underline whitespace-nowrap"
            aria-label={`${social.platform} (@${social.handle})`}
          >
            <span>{getDisplayName(social.platform)}</span>
            <Icon name="arrow-up-right" size={11} class="text-muted-foreground/70" />
          </a>
        ))}
      </div>
    </div>

    <!-- Right: Email Contact & Direct Actions -->
    <div class="footer-contact-wrap flex flex-col items-center lg:items-end gap-2.5">
      <a
        href={`mailto:${siteConfig.email}`}
        class="footer-email inline-flex items-center gap-1.5 text-xs sm:text-[13px] font-medium text-muted-foreground hover:text-foreground px-2.5 py-1.5 rounded-md hover:bg-secondary transition-colors no-underline whitespace-nowrap"
      >
        <Icon name="mail" size={13} class="text-muted-foreground/80" />
        <span>{siteConfig.email}</span>
      </a>

      <!-- Direct Contact Buttons: Call me & WhatsApp -->
      <div class="footer-direct-actions flex items-center gap-2" aria-label="Direct Contact">
        <a
          href={phoneTel}
          class="footer-action-btn inline-flex items-center justify-center gap-1.5 h-8 px-3 text-xs font-medium rounded-md border border-input bg-background hover:bg-secondary hover:text-foreground text-foreground transition-colors no-underline focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring shadow-2xs whitespace-nowrap shrink-0"
          aria-label="Call me"
        >
          <Icon name="phone" size={13} class="text-muted-foreground/80" />
          <span>Call me</span>
        </a>
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="footer-action-btn inline-flex items-center justify-center gap-1.5 h-8 px-3 text-xs font-medium rounded-md border border-input bg-background hover:bg-secondary hover:text-foreground text-foreground transition-colors no-underline focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring shadow-2xs whitespace-nowrap shrink-0"
          aria-label="WhatsApp"
        >
          <Icon name="whatsapp" size={13.5} class="text-muted-foreground/80" />
          <span>WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</footer>
