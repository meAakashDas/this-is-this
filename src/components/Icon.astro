    | 'arrow-up-right'
    | 'search'
    | 'menu'
    | 'x'
    | 'external-link'
    | 'hash'
    | 'book-open'
    | 'compass'
    | 'mail'
    | 'user'
    | 'sparkles'
    | 'instagram'
    | 'youtube'
    | 'tiktok'
    | 'linkedin'
    | 'twitter'
    | 'facebook'
    | 'phone'
    | 'whatsapp'
    | 'link'
    | 'printer'
    | 'share'
    | 'share-2'
    | 'download'
    | 'file-text'
    | 'file-spreadsheet'
    | 'eye'
    | 'chevron-left'
    | 'chevron-right'
    | 'check'
    | 'sun'
    | 'moon'
    | 'info';
  size?: number | string;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 18, class: className = '', strokeWidth = 2 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`lucide-icon lucide-${name} ${className}`}
  aria-hidden="true"
>
  {name === 'arrow-right' && (
    <>
      <path d="M5 12h14" />
      <path d="m12 5 7 7-7 7" />
    </>
  )}

  {name === 'arrow-up-right' && (
    <>
      <path d="M7 17L17 7" />
      <path d="M7 7h10v10" />
    </>
  )}

  {name === 'search' && (
    <>
      <circle cx="11" cy="11" r="8" />
