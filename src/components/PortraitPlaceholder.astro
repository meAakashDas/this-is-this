---
interface Props {
  imageSrc?: string;
  imageAlt?: string;
  caption?: string;
}

const {
  imageSrc,
  imageAlt = 'Aakash Das',
  caption = 'Aakash Das — Kathmandu, Nepal',
} = Astro.props;
---

<figure class="portrait-figure" aria-label="Aakash Das Portrait">
  <div class="portrait-frame">
    {imageSrc ? (
      <img
        src={imageSrc}
        alt={imageAlt}
        class="portrait-img"
        loading="eager"
        decoding="async"
        width="1024"
        height="1024"
      />
    ) : (
      /* Refined, intentional personal identity card with Apple editorial craftsmanship */
      <div class="portrait-identity-card" role="img" aria-label={imageAlt}>
        <div class="identity-lead-row">
          <div class="portrait-monogram" aria-hidden="true">
            AD
          </div>
          <div class="identity-info">
            <span class="identity-name">Aakash Das</span>
            <span class="identity-location">Kathmandu, Nepal</span>
          </div>
          <div class="identity-tag-badge">
            <span>Finance & IT</span>
          </div>
        </div>

        <div class="identity-meta-row">
          <span class="meta-tag">Softwarica College IT</span>
          <span class="meta-sep" aria-hidden="true">·</span>
          <span class="meta-tag">RisePaisa Founder</span>
          <span class="meta-sep" aria-hidden="true">·</span>
          <span class="meta-tag">Open Archive</span>
        </div>
      </div>
    )}
  </div>
  <figcaption class="portrait-caption">
    <span class="caption-marker" aria-hidden="true">
      —
    </span>
    <span>{caption}</span>
  </figcaption>
</figure>

<style>
  .portrait-figure {
    width: 100%;
    margin-top: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .portrait-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .portrait-frame:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-card-hover);
  }

  .portrait-img {
    width: 100%;
    height: 100%;
    max-height: 420px;
    object-fit: cover;
    object-position: center 25%;
    display: block;
  }

  /* Polished, finished Apple-style identity card */
  .portrait-identity-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: clamp(var(--space-4), 4vw, var(--space-6));
    background-color: var(--color-surface);
  }

  .identity-lead-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .portrait-monogram {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--color-text-primary);
    flex-shrink: 0;
    box-shadow: var(--shadow-subtle);
  }

  .identity-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1 1 auto;
  }

  .identity-name {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text-primary);
    letter-spacing: var(--tracking-tight);
  }

  .identity-location {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .identity-tag-badge {
    font-size: var(--text-2xs);
    font-weight: 500;
    color: var(--color-accent);
    background-color: var(--color-accent-subtle);
    border: 1px solid var(--color-accent-border);
    padding: 3px 9px;
    border-radius: var(--radius-full);
  }

  .identity-meta-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-subtle);
    flex-wrap: wrap;
  }

  .meta-tag {
    color: var(--color-text-muted);
  }

  .meta-sep {
    color: var(--color-border-strong);
  }

  .portrait-caption {
    display: flex;
    align-items: center;
    gap: var(--space-1-5);
    margin-top: var(--space-2);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
  }

  .caption-marker {
    color: var(--color-text-faint);
  }
</style>
