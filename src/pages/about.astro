---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getPublicSiteConfig, getPublicAboutPage } from '../lib/cms/contentLoader';

const siteConfig = getPublicSiteConfig();
const aboutPage = getPublicAboutPage();

const pageTitle = aboutPage.seo?.title || `About ${siteConfig.name} — Personal Website`;
const pageDesc = aboutPage.seo?.description || "I'm Aakash Das, a Nepal-based finance educator, content creator, and founder of RisePaisa. I work at the intersection of finance, technology, and education.";

const sectionOrder = aboutPage.sectionOrder || [
  'about-intro',
  'work',
  'media',
  'education',
  'contact',
];

const sectionVisibility = aboutPage.sectionVisibility || {
  'about-intro': true,
  work: true,
  media: true,
  education: true,
  contact: true,
};

const workEntries = aboutPage.workEntries && aboutPage.workEntries.length > 0
  ? aboutPage.workEntries
  : [
      {
        index: '01',
        name: 'RisePaisa',
        desc: 'Building a Nepal-focused financial education platform that makes personal finance, banking, taxation, fintech, and investment concepts easier to understand through educational content, practical resources, and digital learning tools.',
        link: {
          text: 'Visit RisePaisa',
          url: 'https://risepaisa.com',
          isExternal: true,
        },
      },
      {
        index: '02',
        name: 'riseNEPSE',
        desc: "Creating educational content focused on Nepal's stock market, NEPSE, fundamental and technical analysis, and investment knowledge to make stock market education more accessible.",
      },
      {
        index: '03',
        name: 'Finance Education & Content',
        desc: "Creating educational videos, research-based explanations, and practical digital resources covering Nepal's financial system, personal finance, and technology.",
        link: {
          text: 'Explore Resources',
          url: '/resources',
          isExternal: false,
        },
      },
    ];

const mediaEntry = (aboutPage.mediaEntries && aboutPage.mediaEntries[0]) || {
  show: 'The Amit Show',
  role: 'Podcast Guest',
  desc: 'A conversation about building RisePaisa, content creation, audience growth, and my journey as a young entrepreneur and finance educator.',
};

const educationEntries = aboutPage.educationEntries && aboutPage.educationEntries.length > 0
  ? aboutPage.educationEntries
  : [
      {
        index: '01',
        title: 'Information Technology',
        degree: 'BSc (Hons) Information Technology',
        institution: 'Coventry University | Via Softwarica College of IT & E-Commerce',
        period: '2025–2028',
        status: 'Currently pursuing.',
      },
      {
        index: '02',
        title: 'Chartered Accountancy',
        desc: 'Previously pursued Chartered Accountancy studies through ICAI, 2024–2025. Later transitioned towards Information Technology.',
      },
    ];

const introParagraphs = aboutPage.introParagraphs && aboutPage.introParagraphs.length >= 3
  ? aboutPage.introParagraphs
  : [
      "I'm Aakash Das, a Nepal-based finance educator, content creator, and founder of RisePaisa. I work at the intersection of finance, technology, and education, making complex financial topics easier to understand through practical content and digital learning resources.",
      "My work focuses on Nepal's financial system, including personal finance, banking, taxation, fintech, financial literacy, and the stock market. Through RisePaisa, I aim to make reliable financial knowledge more accessible and help students, young professionals, and everyday learners make better-informed financial decisions.",
      "Alongside my work in finance education, I'm studying Information Technology and exploring how technology can improve the way people learn, access information, and manage their finances.",
    ];

const getDisplayName = (platform: string) => {
  if (platform.includes('X') || platform.includes('Twitter')) return 'X';
  return platform;
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  currentPath="/about"
>
  <div class="page-container about-page max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-12 sm:pt-8 sm:pb-16 md:pt-9 md:pb-18 space-y-7 sm:space-y-8">
    {sectionOrder.map((sectionId, idx) => {
      const isVisible = sectionVisibility[sectionId] !== false;
      if (!isVisible) return null;

      if (sectionId === 'about-intro') {
        return (
          <>
            <section class="about-section about-intro-section space-y-3.5 sm:space-y-4" aria-labelledby="about-intro-title">
              <header class="intro-header">
                <h1 id="about-intro-title" class="about-title type-h1 text-foreground m-0 text-balance">
                  {aboutPage.title || 'About Aakash Das'}
                </h1>
              </header>
              <div class="about-lead-copy space-y-3 max-w-[760px]">
                {introParagraphs.map((para, pIdx) => {
                  if (pIdx === 0) {
                    return (
                      <p class="about-lead type-body-lg text-foreground/90 leading-relaxed font-normal m-0">
                        {para.includes('RisePaisa') ? (
                          <>{para.split('RisePaisa')[0]}<a
                              href="https://risepaisa.com"
                              target="_blank"
                              rel="noopener noreferrer"
                              class="brand-link font-semibold text-foreground underline decoration-border underline-offset-4 hover:decoration-foreground transition-colors"
                              aria-label="RisePaisa (opens in a new tab)"
                            >RisePaisa</a>{para.split('RisePaisa').slice(1).join('RisePaisa')}</>
                        ) : (
                          para
                        )}
                      </p>
                    );
                  }
                  if (pIdx === 1) {
                    return (
                      <p class="about-body-text type-body text-muted-foreground leading-relaxed font-normal m-0">
                        {para}
                      </p>
                    );
                  }
                  return (
                    <p class="about-sublead type-body text-muted-foreground leading-relaxed font-normal m-0">
                      {para}
                    </p>
                  );
                })}
              </div>
            </section>
            <div class="h-px bg-border w-full" role="separator"></div>
          </>
        );
      }

      if (sectionId === 'work') {
        return (
          <>
            <section class="about-section about-work-section space-y-4 sm:space-y-5" aria-labelledby="work-heading">
              <div class="section-header">
                <h2 id="work-heading" class="section-title text-2xl sm:text-[28px] font-semibold tracking-tight text-foreground m-0">
                  My Work
                </h2>
              </div>

              <div class="cards-grid work-grid grid grid-cols-1 md:grid-cols-3 gap-5 lg:gap-6">
                {workEntries.map((item) => (
                  <article class="entry-card work-card rounded-xl border border-border bg-card text-card-foreground shadow-xs hover:border-border-strong transition-all flex flex-col h-full p-5 sm:p-6">
                    <div class="card-top-bar flex items-center justify-between gap-2 mb-3 sm:mb-3.5">
                      <span class="entry-index font-mono text-xs font-semibold px-2 py-0.5 rounded-md border border-border bg-secondary text-muted-foreground">
                        {item.index}
                      </span>
                    </div>
                    <h3 class="card-title text-lg sm:text-[19px] font-semibold tracking-tight text-foreground m-0 mb-2">
                      {item.name}
                    </h3>
                    <p class="card-detail text-sm sm:text-[14.5px] text-muted-foreground leading-relaxed flex-1 m-0 mb-4">
                      {item.desc}
                    </p>
                    {item.link && (
                      <div class="card-action-wrap mt-auto pt-3.5 border-t border-border">
                        <a
                          href={item.link.url}
                          target={item.link.isExternal ? '_blank' : undefined}
                          rel={item.link.isExternal ? 'noopener noreferrer' : undefined}
                          class="entry-link inline-flex items-center gap-1.5 text-xs font-medium text-foreground hover:text-foreground/80 transition-colors no-underline group"
                        >
                          <span>{item.link.text}</span>
                          <Icon
                            name={item.link.isExternal ? 'arrow-up-right' : 'arrow-right'}
                            size={12}
                            class="link-arrow text-muted-foreground transition-transform group-hover:translate-x-0.5"
                          />
                        </a>
                      </div>
                    )}
                  </article>
                ))}
              </div>
            </section>
            <div class="h-px bg-border w-full" role="separator"></div>
          </>
        );
      }

      if (sectionId === 'media') {
        return (
          <>
            <section class="about-section about-media-section space-y-4 sm:space-y-5" aria-labelledby="media-heading">
              <div class="section-header">
                <h2 id="media-heading" class="section-title text-2xl sm:text-[28px] font-semibold tracking-tight text-foreground m-0">
                  Conversations & Media
                </h2>
              </div>

              <article class="media-feature-card rounded-xl border border-border bg-card text-card-foreground shadow-xs hover:border-border-strong transition-all p-5 sm:p-6 md:p-7 space-y-3">
                <div class="media-card-header">
                  <div class="media-badge-group flex items-center gap-2 flex-wrap">
                    <span class="card-role-badge media-role-badge inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-mono font-medium border border-border bg-secondary text-muted-foreground">
                      {mediaEntry.role}
                    </span>
                    <span class="media-format-tag inline-flex items-center px-2 py-0.5 rounded-md text-xs font-mono font-medium text-muted-foreground">
                      Featured Interview
                    </span>
                  </div>
                </div>
                <div class="media-card-body space-y-2">
                  <h3 class="media-show-title text-lg sm:text-[19px] font-semibold tracking-tight text-foreground m-0">
                    {mediaEntry.show}
                  </h3>
                  <p class="media-show-desc text-sm sm:text-base text-muted-foreground leading-relaxed m-0 max-w-2xl">
                    {mediaEntry.desc}
                  </p>
                </div>
              </article>
            </section>
            <div class="h-px bg-border w-full" role="separator"></div>
          </>
        );
      }

      if (sectionId === 'education') {
        return (
          <>
            <section class="about-section about-education-section space-y-4 sm:space-y-5" aria-labelledby="education-heading">
              <div class="section-header">
                <h2 id="education-heading" class="section-title text-2xl sm:text-[28px] font-semibold tracking-tight text-foreground m-0">
                  Education
                </h2>
              </div>

              <div class="cards-grid education-grid grid grid-cols-1 md:grid-cols-2 gap-5 lg:gap-6">
                {educationEntries.map((edu) => (
                  <article class="entry-card education-card rounded-xl border border-border bg-card text-card-foreground shadow-xs hover:border-border-strong transition-all p-5 sm:p-6 flex flex-col space-y-2.5 h-full">
                    <div class="card-top-bar flex items-center justify-between gap-2">
                      <span class="entry-index font-mono text-xs font-semibold px-2 py-0.5 rounded-md border border-border bg-secondary text-muted-foreground">
                        {edu.index}
                      </span>
                      {edu.period && (
                        <span class="edu-period-tag text-xs font-mono text-muted-foreground">
                          {edu.period}
                        </span>
                      )}
                    </div>
                    <h3 class="card-title text-lg font-semibold tracking-tight text-foreground m-0">
                      {edu.title}
                    </h3>
                    {edu.degree && (
                      <p class="edu-degree-line text-sm font-medium text-foreground m-0">
                        {edu.degree}
                      </p>
                    )}
                    {edu.institution && (
                      <p class="edu-institution-line text-xs text-muted-foreground m-0">
                        {edu.institution}
                      </p>
                    )}
                    {edu.desc && (
                      <p class="card-detail text-sm text-muted-foreground leading-relaxed m-0 flex-1">
                        {edu.desc}
                      </p>
                    )}
                    {edu.status && (
                      <div class="edu-status-wrap inline-flex items-center gap-1.5 pt-2 text-xs text-emerald-600 dark:text-emerald-400 font-medium mt-auto">
                        <span class="status-pulse-dot w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
                        <span class="status-text">{edu.status}</span>
                      </div>
                    )}
                  </article>
                ))}
              </div>
            </section>
            <div class="h-px bg-border w-full" role="separator"></div>
          </>
        );
      }

      if (sectionId === 'contact') {
        return (
          <section class="about-section about-contact-section space-y-4 sm:space-y-5" aria-labelledby="contact-heading">
            <div class="section-header">
              <h2 id="contact-heading" class="section-title text-2xl sm:text-[28px] font-semibold tracking-tight text-foreground m-0">
                Get in Touch
              </h2>
            </div>

            <div class="contact-actions-row flex items-center gap-3 flex-wrap">
              <a
                href={`mailto:${siteConfig.email}`}
                class="email-cta-btn btn btn-primary inline-flex items-center gap-2 h-10 px-4 text-xs font-mono font-medium rounded-md bg-primary text-primary-foreground hover:bg-primary/90 transition-colors shadow-sm no-underline"
              >
                <Icon name="mail" size={16} />
                <span>{siteConfig.email}</span>
              </a>

              <div class="social-links-pills flex items-center gap-2 flex-wrap" aria-label="Social Channels">
                {siteConfig.socialLinks.map((social) => (
                  <a
                    href={social.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="social-channel-pill inline-flex items-center gap-1.5 h-10 px-3.5 text-xs font-medium rounded-md border border-input bg-background hover:bg-secondary hover:text-foreground text-foreground transition-colors shadow-xs no-underline"
                    aria-label={`${social.platform} (@${social.handle})`}
                  >
                    <span>{getDisplayName(social.platform)}</span>
                    <Icon name="arrow-up-right" size={11} class="external-arrow text-muted-foreground/70" />
                  </a>
                ))}
              </div>
            </div>
          </section>
        );
      }

      return null;
    })}

    <!-- Discreet Administrator Sign-In Entry Point -->
    <div class="admin-entry-wrap pt-10 pb-2 flex justify-center text-center">
      <a
        href="/admin"
        class="admin-sign-in-link text-[11px] font-normal text-muted-foreground/35 hover:text-muted-foreground/75 transition-colors duration-200 no-underline"
        aria-label="Admin Sign In"
      >
        Sign in
      </a>
    </div>
  </div>
</BaseLayout>
